<UserControl x:Class="WpfChatClient.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WpfChatClient.ViewModels"
             xmlns:models="clr-namespace:WpfChatClient.Core.Models"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnectViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Spin animation for radar icon -->
        <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RadarIcon"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:2.5"/>
        </Storyboard>

        <!-- Pulse animation for scan ring -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.1" To="0.5" Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Width"
                             From="75" To="105" Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Height"
                             From="75" To="105" Duration="0:0:1"/>
        </Storyboard>

        <!-- Server list item style -->
        <Style x:Key="ServerItemBorder" TargetType="Border">
            <Setter Property="Background" Value="#14AAAAFF"/>
            <Setter Property="BorderBrush" Value="#33AAAAFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Secondary ghost button -->
        <Style x:Key="GhostButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Background" Value="#20AAAAFF"/>
            <Setter Property="Foreground" Value="{StaticResource BrightTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#44AAAAFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40AAAAFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SpinAnimation}" Name="SpinSB"/>
            <BeginStoryboard Storyboard="{StaticResource PulseAnimation}" Name="PulseSB"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Background="Transparent">
        <Border Style="{StaticResource BrightGlassCard}"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="430" MaxHeight="640"
                Padding="34,30">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- ══════════════════════════════════
                         HEADER (always visible)
                    ══════════════════════════════════ -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Join the Chat" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource BrightTextPrimary}"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                       Foreground="{StaticResource BrightTextSecondary}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Avatar circle (top-right) -->
                        <Grid Grid.Column="1" Width="58" Height="58"
                              VerticalAlignment="Top" Margin="14,0,0,0">
                            <!-- Avatar image fill -->
                            <Ellipse Width="56" Height="56" Cursor="Hand">
                                <Ellipse.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding PickAvatarCommand}"/>
                                </Ellipse.InputBindings>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="{StaticResource LiquidAccent}"/>
                                        <Setter Property="StrokeThickness" Value="2"/>
                                        <Setter Property="Fill" Value="#22AAAAFF"/>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Avatar image when set -->
                            <Ellipse Width="56" Height="56" IsHitTestVisible="False">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Camera icon overlay when no avatar -->
                            <TextBlock Text="📷" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- "Change" tooltip label under avatar -->
                            <TextBlock Text="change" FontSize="9"
                                       Foreground="{StaticResource LiquidAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,-14" Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding PickAvatarCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- ══════════════════════════════════
                         PHASE: SCANNING
                    ══════════════════════════════════ -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Width="120" Height="120" HorizontalAlignment="Center">
                            <Ellipse x:Name="PulseRing"
                                     Width="90" Height="90"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="Transparent"
                                     Stroke="#7C8CFF" StrokeThickness="1.5"
                                     Opacity="0.2"/>
                            <TextBlock x:Name="RadarIcon"
                                       Text="📡" FontSize="42"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="Scanning your local network…" FontSize="13"
                                   Foreground="{StaticResource BrightTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- ══════════════════════════════════
                         PHASE: SERVER LIST
                    ══════════════════════════════════ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerListPhase}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Username -->
                        <TextBlock Text="Your Name" Foreground="{StaticResource BrightTextSecondary}"
                                   FontSize="11" FontWeight="Bold" Margin="2,0,0,5"/>
                        <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource BrightGlassTextBox}"
                                    PlaceholderText="Enter your display name"
                                    Margin="0,0,0,16"/>

                        <!-- Server list (shown when servers found) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Servers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Available Servers"
                                       Foreground="{StaticResource BrightTextSecondary}"
                                       FontSize="11" FontWeight="Bold" Margin="2,0,0,8"/>

                            <ListBox ItemsSource="{Binding Servers}"
                                     SelectedItem="{Binding SelectedServer}"
                                     Background="Transparent" BorderThickness="0"
                                     MaxHeight="200"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,12">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="#14AAAAFF"
                                                            BorderBrush="#33AAAAFF"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="12,9"
                                                            Margin="0,0,0,5">
                                                        <ContentPresenter/>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Background" Value="#33AAAAFF"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource LiquidAccent}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ServerInfo}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🖥️" FontSize="22"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrightTextPrimary}"/>
                                                <TextBlock Text="{Binding Ip}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource BrightTextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock FontSize="11" Foreground="#4ECDC4"
                                                           HorizontalAlignment="Right">
                                                    <Run Text="{Binding OnlineCount}"/><Run Text=" online"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Port, StringFormat='Port {0}'}"
                                                           FontSize="10" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource BrightTextMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- No-server callout (shown when servers list empty) -->
                        <Border CornerRadius="12" Background="#15FF8866"
                                BorderBrush="#44FF8866" BorderThickness="1"
                                Padding="14,12" Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Servers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="⚠️  No servers found on your network."
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#CC5533" TextWrapping="Wrap"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource BrightTextSecondary}"
                                           TextWrapping="Wrap" Margin="0,6,0,6">
                                    Nobody is hosting yet. You can enter an IP manually or
                                    start <Run FontWeight="SemiBold">ChatServer.exe</Run> on this machine and tell
                                    classmates to connect to your Wi-Fi IP address (from
                                    <Run FontStyle="Italic">ipconfig</Run>).
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Error -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Buttons row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>

                            <!-- Connect to selected -->
                            <ui:Button Grid.Column="0"
                                       Content="Connect"
                                       Command="{Binding ConnectToSelectedCommand}"
                                       Height="43"
                                       HorizontalAlignment="Stretch">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource ModernButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Servers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <!-- Manual IP entry shortcut -->
                            <ui:Button Grid.Column="2"
                                       Content="Manual IP"
                                       Command="{Binding EnterManuallyCommand}"
                                       Style="{StaticResource GhostButton}"
                                       Height="43" Padding="14,0"/>

                            <!-- Re-scan -->
                            <ui:Button Grid.Column="4"
                                       Content="🔄"
                                       Command="{Binding RescanCommand}"
                                       Style="{StaticResource GhostButton}"
                                       Height="43" Width="43"
                                       ToolTip="Scan again"/>
                        </Grid>
                    </StackPanel>

                    <!-- ══════════════════════════════════
                         PHASE: MANUAL ENTRY
                    ══════════════════════════════════ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManualPhase}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Username -->
                        <TextBlock Text="Your Name" Foreground="{StaticResource BrightTextSecondary}"
                                   FontSize="11" FontWeight="Bold" Margin="2,0,0,5"/>
                        <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource BrightGlassTextBox}"
                                    PlaceholderText="Enter your display name"
                                    Margin="0,0,0,14"/>

                        <!-- IP + Port -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="88"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Server IP" Foreground="{StaticResource BrightTextSecondary}"
                                           FontSize="11" FontWeight="Bold" Margin="2,0,0,5"/>
                                <ui:TextBox Text="{Binding ManualIp, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource BrightGlassTextBox}"
                                            PlaceholderText="192.168.x.x"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" Foreground="{StaticResource BrightTextSecondary}"
                                           FontSize="11" FontWeight="Bold" Margin="2,0,0,5"/>
                                <ui:TextBox Text="{Binding ManualPort, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource BrightGlassTextBox}"
                                            PlaceholderText="5000"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Same PC: 127.0.0.1 · Classmate: their Wi-Fi IPv4 (run ipconfig)"
                                   FontSize="11" Foreground="{StaticResource BrightTextMuted}"
                                   TextWrapping="Wrap" Margin="2,0,0,14" FontStyle="Italic"/>

                        <!-- Error -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0"
                                       Content="← Back"
                                       Command="{Binding BackToListCommand}"
                                       Style="{StaticResource GhostButton}"
                                       Height="43" Padding="16,0"/>
                            <ui:Button Grid.Column="2"
                                       Content="Connect"
                                       Command="{Binding ConnectManuallyCommand}"
                                       Style="{StaticResource ModernButton}"
                                       Height="43"
                                       HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>

                    <!-- ══════════════════════════════════
                         PHASE: CONNECTING SPINNER
                    ══════════════════════════════════ -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,16">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"
                                         HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                                   Foreground="{StaticResource BrightTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
